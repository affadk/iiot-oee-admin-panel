# IIoT OEE Admin Panel Frontend Configuration (Build Guide §4.1)
#
# Mode API (demo | real). Default: demo (data in-memory, tanpa backend).
# - demo: seluruh halaman memakai store demo lokal.
# - real: HTTP ke backend via VITE_API_URL (+ WS via VITE_WS_URL).
# Bisa juga diubah dari Topbar (API: Demo/Real) atau query ?api=real — pilihan
# tersimpan di localStorage `iiot-oee-api-mode` (bukan token).
VITE_API_MODE=demo

# Leave VITE_API_URL empty in production to use origin + /api/v1 via Nginx dual-vhost proxy
VITE_API_URL=
VITE_WS_URL=
VITE_AUTH_TTL_FALLBACK_SEC=900
VITE_REQUEST_TIMEOUT_MS=10000
VITE_EXPORT_TIMEOUT_MS=120000

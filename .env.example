# IIoT OEE Admin Panel — Konfigurasi Frontend (Build Guide §4.1)
#
# SEMUA switch & nilai sistem tinggal di file ini (dibaca `src/services/api/mode.ts`,
# satu-satunya sumber kebenaran). Nilai `VITE_*` adalah BUILD-TIME: dibakar ke
# bundle saat `vite build`, sehingga mengubahnya = build/deploy ulang.
# JANGAN taruh rahasia di sini (password/token) — token sesi hanya di memori (D5).
#
# ── Mode API ────────────────────────────────────────────────────────────────
# demo = store in-memory lokal (tanpa backend). real = HTTP ke backend.
VITE_API_MODE=demo

# Kunci switch mode. Default false = mode TERKUNCI di env: Topbar hanya
# menampilkan badge read-only, dan `?api=` / localStorage diabaikan.
# Set `true` HANYA untuk dev/evaluasi lokal bila mode perlu dialihkan dari UI.
VITE_ALLOW_API_MODE_SWITCH=false

# Preset login demo (tombol ADM-001/SUP-042/OP-115/MNT-208 + prefill form).
# Default true, TAPI otomatis MATI bila VITE_API_MODE=real — preset tidak
# pernah tampil di env non-demo, sekalipun mode sempat dialihkan ke demo.
VITE_DEMO_PRESET_LOGIN=true

# ── Endpoint Real ───────────────────────────────────────────────────────────
# Kosongkan VITE_API_URL di produksi: pakai origin + /api/v1 via Nginx dual-vhost.
VITE_API_URL=
VITE_WS_URL=

# ── Timeout & retry HTTP (Guide §4.2) ───────────────────────────────────────
VITE_REQUEST_TIMEOUT_MS=10000
VITE_MUTATION_TIMEOUT_MS=15000
VITE_EXPORT_TIMEOUT_MS=120000
# Maksimal percobaan untuk GET yang gagal jaringan / 502/503/504 (1–5).
VITE_HTTP_RETRY_MAX_ATTEMPTS=3

# ── Sesi (Guide §4.4) ───────────────────────────────────────────────────────
# TTL fallback bila backend tidak mengembalikan expires_in (900 = 15 menit).
VITE_AUTH_TTL_FALLBACK_SEC=900

# ── Akses jaringan — dual-vhost D1 ──────────────────────────────────────────
# LAN = akses penuh (port 80). REMOTE_TUNNEL = read-only (port tunnel).
# Kosongkan untuk deteksi otomatis dari port; isi eksplisit untuk override.
VITE_NETWORK_MODE=
VITE_TUNNEL_PORT=8080

# ── Mode akses Private / Public ─────────────────────────────────────────────
# private (default) = akses penuh HANYA dari LAN pabrik; via internet publik
#   (tunnel) panel read-only — mutasi ditolak 403.
# public = akses penuh diizinkan juga via internet publik. Nyalakan hanya bila
#   pabrik memang membuka panel ke internet — keputusan sadar, dan backend
#   WAJIB menegakkan aturan yang sama di server (lihat
#   docs/BACKEND_REQUIREMENTS_ACCESS_MODE.md).
VITE_ACCESS_MODE=private

# Kunci switch mode akses. Default false = mode TERKUNCI di env: Topbar hanya
# menampilkan badge read-only, dan `?access=` / localStorage diabaikan.
# Set `true` HANYA untuk dev/evaluasi lokal bila mode perlu dialihkan dari UI.
VITE_ALLOW_ACCESS_MODE_SWITCH=false

# Kunci tombol simulasi mode jaringan di banner. Default false = banner hanya
# indikator status; mode berasal dari env/deployment, bukan klik di UI.
# Set `true` HANYA untuk dev lokal.
VITE_ALLOW_NETWORK_MODE_SIMULATION=false

# ── WebSocket ───────────────────────────────────────────────────────────────
VITE_WS_HEARTBEAT_MS=25000
VITE_WS_RECONNECT_MAX_MS=30000
# Interval emisi simulasi telemetri saat mode Demo.
VITE_DEMO_SIM_INTERVAL_MS=5000

# ── Identitas deployment ────────────────────────────────────────────────────
VITE_PLANT_LABEL=Plant 01
VITE_DEFAULT_STATION_ID=ADMIN-CONSOLE-01
